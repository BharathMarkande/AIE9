TAVILY_API_KEY=

# Optional LangSmith (for Studio auth to remote servers)
LANGSMITH_API_KEY=
LANGSMITH_TRACING_V2=
LANGSMITH_PROJECT=

# Optional LangSmith (for Studio auth to remote servers)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=
LANGCHAIN_PROJECT=

# Models/config
OPENAI_MODEL=gpt-4.1-nano

# RAG configuration
RAG_DATA_DIR=data


# Provider: "openai" or "fireworks" (used for both chat and embeddings).
# If unset, inferred from OPENAI_API_KEY or FIREWORKS_API_KEY.
LLM_PROVIDER=

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Fireworks (when LLM_PROVIDER=fireworks)
FIREWORKS_API_KEY=
FIREWORKS_CHAT_MODEL=
FIREWORKS_EMBEDDING_MODEL=